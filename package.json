{
  "name": "uapic-led-player",
  "private": true,
  "version": "1.1.1",
  "description": "Digital signage & LED display player (dual-window editor + output)",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "start": "vite build && electron .",
    "build:web": "vite build",
    "build": "vite build && electron-builder",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.uapic.ledplayer",
    "productName": "Uapic LED Player",
    "directories": {
      "output": "release"
    },
    "icon": "icon.png",
    "fileAssociations": [
      {
        "ext": "ulp",
        "name": "Uapic Project File",
        "description": "Uapic LED Player Scene Project",
        "role": "Editor",
        "icon": "icon.png"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "icon.png",
      "package.json"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Uapic LED Player"
    }
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.14",
    "vite-plugin-electron": "^0.29.1",
    "wait-on": "^9.0.10"
  }
}
